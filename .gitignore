*
!/.gitignore
!/.gitattributes
!/README.md
!/LICENSE
!/docs/
!/docs/technical-notes.md
!/docs/architecture.md
!/docs/totalmarker-standalone.md
!/docs/asset-credits.md
!/.github/
!/.github/workflows/
!/.github/workflows/offline-tests.yml
!/scripts/
!/scripts/totalmarker/
!/scripts/totalmarker/**
!/scripts/run-totalmarker
!/scripts/xplanet.sh
!/scripts/xp-setup.sh
!/scripts/xp-bootstrap.sh
!/scripts/lib/
!/scripts/lib/xplanet/
!/scripts/lib/xplanet/*.zsh
!/scripts/launchd/
!/scripts/launchd/*.plist.example
/scripts/launchd/*.plist
!/dev/
!/dev/tests/
!/dev/tests/**
!/dev/examples/
!/dev/examples/*.example.toml
!/dev/release/
!/dev/release/build_candidate.py
# Existing assets stay tracked; adding assets requires deliberate git add -f.
# Unknown imagery/configuration under assets remains excluded by default.
!/config/
!/config/totalmarker.example.toml
!/config/earth.example
!/config/xp.conf.example
!/config/xp.def.example
**/__pycache__/
*.py[cod]
*.ini
**/.env*
**/*.pem
**/*.key
**/*.log
/dev/tests/.tmp/
/dev/tests/.tmp/**
