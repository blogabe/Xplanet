**/__pycache__/
*.py[cod]
*.ini
**/.env*
**/*.pem
**/*.key
**/*.log
/tests/.tmp/
/tests/.tmp/**

!/docs/configurator/
!/docs/configurator/*.md
!/docs/configurator.md
!/docs/configurator-user-guide.md

/tests/**/.tmp/
/tests/**/.tmp/**

# Private generated previews and durable user exports, never release inputs.
/output/

