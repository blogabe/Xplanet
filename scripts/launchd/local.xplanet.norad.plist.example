<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>local.xplanet.norad</string>
	<key>WorkingDirectory</key>
	<string>__XPLANET_ROOT__</string>
	<key>ProgramArguments</key>
	<array>
		<string>__XPLANET_ROOT__/scripts/xplanet.sh</string>
		<string>norad</string>
	</array>
	<key>StartCalendarInterval</key>
	<array>
		<dict>
			<key>Minute</key>
			<integer>40</integer>
			<key>Hour</key>
			<integer>0</integer>
		</dict>
		<dict>
			<key>Minute</key>
			<integer>40</integer>
			<key>Hour</key>
			<integer>3</integer>
		</dict>
		<dict>
			<key>Minute</key>
			<integer>40</integer>
			<key>Hour</key>
			<integer>6</integer>
		</dict>
		<dict>
			<key>Minute</key>
			<integer>40</integer>
			<key>Hour</key>
			<integer>9</integer>
		</dict>
		<dict>
			<key>Minute</key>
			<integer>40</integer>
			<key>Hour</key>
			<integer>12</integer>
		</dict>
		<dict>
			<key>Minute</key>
			<integer>40</integer>
			<key>Hour</key>
			<integer>15</integer>
		</dict>
		<dict>
			<key>Minute</key>
			<integer>40</integer>
			<key>Hour</key>
			<integer>18</integer>
		</dict>
		<dict>
			<key>Minute</key>
			<integer>40</integer>
			<key>Hour</key>
			<integer>21</integer>
		</dict>
	</array>
	<key>StandardOutPath</key>
	<string>__XPLANET_ROOT__/logs/xplanet.log</string>
	<key>StandardErrorPath</key>
	<string>__XPLANET_ROOT__/logs/xplanet-norad.log</string>
</dict>
</plist>
