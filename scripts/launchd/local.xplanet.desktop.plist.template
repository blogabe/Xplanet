<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>local.xplanet.desktop</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/zsh</string>
        <string>__XPLANET_ROOT__/scripts/lib/xplanet/desktop.zsh</string>
    </array>
    <key>WorkingDirectory</key>
    <string>__XPLANET_ROOT__</string>
    <key>StandardOutPath</key>
    <string>__XPLANET_ROOT__/logs/xplanet.log</string>
    <key>StandardErrorPath</key>
    <string>__XPLANET_ROOT__/logs/xplanet-error.log</string>
</dict>
</plist>
