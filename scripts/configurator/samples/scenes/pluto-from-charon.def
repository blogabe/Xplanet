# Xplanet configurator scene v14; saving does not apply it.
XPLANET_BIN=/usr/bin/xplanet
XPLANET_HOME="$project_root"
XPLANET_CONFIG="$project_root/config"
XPLANET_SCENE_MODE=space
XPLANET_PROJECTION=
XPLANET_OBSERVER=charon
XPLANET_GEOMETRY=1920x1080
XPLANET_LATITUDE=0
XPLANET_LONGITUDE=0
XPLANET_FRAMING=fov
XPLANET_RADIUS=36
XPLANET_FOV=20
XPLANET_TIME_MODE=fixed
XPLANET_UTC=2000-01-01T12:00:00Z
EARTH_MAP_PRE=stock
XPLANET_ASSET_ROOT=/xplanet
XPLANET_MAP_FAMILY=stock
XPLANET_MAP_MONTH=01
XPLANET_NIGHT=stock
XPLANET_TWILIGHT=6
XPLANET_GRID=off
XPLANET_LABEL=off
XPLANET_PLACES=off
XPLANET_PLACES_FILE=
XPLANET_PLACE_COLOR=yellow
XPLANET_PLACE_SIZE=14
XPLANET_ROUTES=off
XPLANET_ROUTES_FILE=
XPLANET_ROUTE_COLOR=cyan
XPLANET_ROUTE_WIDTH=2
XPLANET_RELIEF=off
XPLANET_RELIEF_SCALE=1
XPLANET_RELIEF_SHADOW=night
XPLANET_RELIEF_SHADE=30
XPLANET_SPECULAR=off
XPLANET_CLOUDS=off
XPLANET_CLOUD_GAMMA=1
XPLANET_CLOUD_THRESHOLD=90
XPLANET_CLOUD_CAPTURE=
XPLANET_LONGITUDE_MODE=longitude
XPLANET_SOLAR_HOUR=12
XPLANET_DISTANCE=1000
XPLANET_NORTH=body
XPLANET_ROTATION=0
XPLANET_TARGET=pluto
XPLANET_PLANET_SHADE=15
XPLANET_QUAKE_LAYER=off
XPLANET_VOLCANO_LAYER=off
XPLANET_STORM_LAYER=off
XPLANET_OBSERVATIONS=
XPLANET_COMPOSITION=target
XPLANET_SATELLITE_SCALE=1
XPLANET_ORBIT_PATHS=off
XPLANET_ORBIT_COLOR=cyan
XPLANET_ORBIT_WIDTH=1
XPLANET_MOON_SCALES=''
