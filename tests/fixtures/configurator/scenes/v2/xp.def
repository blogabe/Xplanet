# Xplanet configurator scene v2; saving does not apply it.
XPLANET_BIN=/path/to/xplanet
XPLANET_HOME="$project_root"
XPLANET_CONFIG="$project_root/config"
XPLANET_SCENE_MODE=map
XPLANET_PROJECTION=rectangular
XPLANET_OBSERVER=geographic
XPLANET_GEOMETRY=800x600
XPLANET_LATITUDE=0
XPLANET_LONGITUDE=0
XPLANET_FRAMING=radius
XPLANET_RADIUS=45
XPLANET_FOV=30
XPLANET_TIME_MODE=now
XPLANET_UTC=2000-01-01T12:00:00Z
EARTH_MAP_PRE=stock
