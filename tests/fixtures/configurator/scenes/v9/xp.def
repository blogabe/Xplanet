# Xplanet configurator scene v9; saving does not apply it.
XPLANET_BIN=/path/to/xplanet
XPLANET_HOME="$project_root"
XPLANET_CONFIG="$project_root/config"
XPLANET_SCENE_MODE=map
XPLANET_PROJECTION=rectangular
XPLANET_OBSERVER=geographic
XPLANET_GEOMETRY=800x600
XPLANET_LATITUDE=0
XPLANET_LONGITUDE=0
XPLANET_FRAMING=radius
XPLANET_RADIUS=45
XPLANET_FOV=30
XPLANET_TIME_MODE=now
XPLANET_UTC=2000-01-01T12:00:00Z
EARTH_MAP_PRE=stock
XPLANET_ASSET_ROOT=/xplanet
XPLANET_MAP_FAMILY=stock
XPLANET_MAP_MONTH=01
XPLANET_NIGHT=stock
XPLANET_TWILIGHT=6
XPLANET_GRID=off
XPLANET_LABEL=off
XPLANET_PLACES=off
XPLANET_PLACES_FILE=
XPLANET_PLACE_COLOR=yellow
XPLANET_PLACE_SIZE=14
XPLANET_ROUTES=off
XPLANET_ROUTES_FILE=
XPLANET_ROUTE_COLOR=cyan
XPLANET_ROUTE_WIDTH=2
XPLANET_RELIEF=off
XPLANET_RELIEF_SCALE=1
XPLANET_RELIEF_SHADOW=night
XPLANET_RELIEF_SHADE=30
XPLANET_SPECULAR=off
XPLANET_CLOUDS=off
XPLANET_CLOUD_GAMMA=1
XPLANET_CLOUD_THRESHOLD=90
XPLANET_CLOUD_CAPTURE=
XPLANET_LONGITUDE_MODE=longitude
XPLANET_SOLAR_HOUR=12
XPLANET_DISTANCE=1000
XPLANET_NORTH=body
XPLANET_ROTATION=0
XPLANET_TARGET=earth
XPLANET_PLANET_SHADE=30
